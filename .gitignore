# local only: the SQLite db, OTel logs, hook marks, generated reports
data/
reports/
# benchmark snapshots (git archives of a client repo) and replay worktrees
bench/snapshots/
bench/replay/
# optimize jobs: copies of your skills and the runs' drafts
bench/optimize/
bench/*.log
__pycache__/
*.pyc
# generated by Claude Code for the mod's editor types
mod/.claude-plugin/types/
# Python packaging output
build/
dist/
*.egg-info/
# per-machine secret for report aliases (tokscope report --privacy numbers); never share it
privacy.key
# client benchmark tasks: they name a private repo and hold its prompts
bench/tasks/
